<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="groupUptownFile.MainPage">

    <ScrollView>

    
    <VerticalStackLayout 
        Padding="30"
        Spacing="20"
        VerticalOptions="Center">

        <Label 
            Text="Main Menu"
            FontSize="28"
            HorizontalOptions="Center" />

       
        <Button Text="Home" Clicked="OnHomeClicked"/>
        <Button Text="Profile" Clicked="OnProfileClicked"/>
        <Button Text="Settings" Clicked="OnSettingsClicked"/>
        <Button Text="About Us" Clicked="OnAboutClicked"/>
        <Button Text="Shortcut" Clicked="OnShortcutClicked"/>

    </VerticalStackLayout>

</ScrollView>

</ContentPage>
